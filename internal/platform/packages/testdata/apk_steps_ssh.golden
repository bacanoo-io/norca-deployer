# Managed by norca-deployer. Do not edit: the deployer writes this file whole.
https://dl-cdn.alpinelinux.org/alpine/v3.22/community
@norca-mine https://apk.example.com/v3.22/main
--- check
# check: apk repositories
if {
true
}; then echo 'norca-step yes'; else echo 'norca-step no'; fi
--- apply
# apply: apk repositories
set -eu
log() { printf 'log %s\n' "$*"; }
apk --wait 300 update >/dev/null
log 'repositories: indexes read'
=== apk keys the plan dropped (secret false, lines true)
--- apply
# apply: apk keys the plan dropped
set -eu
# apk_key_drop NAME removes a key of /etc/apk/keys that an earlier plan
# installed, unless a package owns it (the keys of Alpine).
apk_key_drop() {
  apk_kf=/etc/apk/keys/$1
  [ -e "$apk_kf" ] || return 0
  if apk info -q --who-owns "$apk_kf" >/dev/null 2>&1; then
    return 0
  fi
  rm -f "$apk_kf"
  echo "removed $apk_kf"
}
apk_keys_keep='packager-6b0763be.rsa.pub'
if [ -f /var/lib/norca-deployer/apk-keys ]; then
  while IFS= read -r apk_key; do
    [ -n "$apk_key" ] || continue
    if printf '%s\n' "$apk_keys_keep" | grep -qxF -- "$apk_key"; then
      continue
    fi
    apk_key_drop "$apk_key"
  done </var/lib/norca-deployer/apk-keys
fi
mkdir -p /var/lib/norca-deployer
printf '%s\n' "$apk_keys_keep" >/var/lib/norca-deployer/apk-keys
=== apk packages (secret false, lines false)
--- check
# check: apk packages
# apk_version NAME prints the installed version of a package.
apk_version() {
  awk -v p="P:$1" '$0 == p { f = 1; next } f && /^V:/ { print substr($0, 3); exit } /^$/ { f = 0 }' /lib/apk/db/installed 2>/dev/null
}
# apk_has NAME VERSION is true when the package is installed (at VERSION,
# when one is given).
apk_has() {
  apk_v=$(apk_version "$1")
  [ -n "$apk_v" ] && { [ -z "$2" ] || [ "$apk_v" = "$2" ]; }
}
# apk_world ENTRY is true when /etc/apk/world has the entry (name@tag=version).
apk_world() {
  grep -qxF -- "$1" /etc/apk/world 2>/dev/null
}
if {
apk_has 'containerd' '1.7.27-r0' &&
  apk_world 'containerd=1.7.27-r0' &&
  apk_has 'norca-agent' '0.3.0-r1' &&
  apk_world 'norca-agent@norca-mine' &&
  apk_has 'jq' '' &&
  apk_world "jq=$(apk_version 'jq')" &&
  apk_has 'tree' '' &&
  apk_world 'tree'
}; then echo 'norca-step yes'; else echo 'norca-step no'; fi
--- apply
# apply: apk packages
set -eu
# apk_version NAME prints the installed version of a package.
apk_version() {
  awk -v p="P:$1" '$0 == p { f = 1; next } f && /^V:/ { print substr($0, 3); exit } /^$/ { f = 0 }' /lib/apk/db/installed 2>/dev/null
}
apk --wait 300 add -q -U 'containerd=1.7.27-r0' 'norca-agent@norca-mine=0.3.0-r1' 'jq' 'tree'
apk --wait 300 add -q 'norca-agent@norca-mine' "jq=$(apk_version 'jq')"
=== apk versions (secret false, lines false)
--- apply
# apply: apk versions
set -eu
log() { printf 'log %s\n' "$*"; }
die() {
  printf 'error %s\n' "$*"
  exit 1
}
# apk_version NAME prints the installed version of a package.
apk_version() {
  awk -v p="P:$1" '$0 == p { f = 1; next } f && /^V:/ { print substr($0, 3); exit } /^$/ { f = 0 }' /lib/apk/db/installed 2>/dev/null
}
# apk_expect NAME VERSION stops unless the package is installed (at
# VERSION, when one is given).
apk_expect() {
  apk_v=$(apk_version "$1")
  [ -n "$apk_v" ] || die "package $1 is not installed after apk add"
  [ -z "$2" ] || [ "$apk_v" = "$2" ] || die "package $1: version $apk_v installed, $2 requested"
  if apk_held "$1"; then
    log "package $1 $apk_v (held)"
  else
    log "package $1 $apk_v"
  fi
}
# apk_held NAME is true when the world entry of a package has a version
# constraint (name=1.2-r0, name@tag=1.2-r0, or name><checksum of a file).
apk_held() {
  awk -v n="$1" '{ e = $0; sub(/[=<>~].*/, "", e); sub(/@.*/, "", e) } e == n && /[=<>~]/ { h = 1 } END { exit !h }' /etc/apk/world 2>/dev/null
}
apk_expect 'containerd' '1.7.27-r0'
apk_expect 'norca-agent' '0.3.0-r1'
apk_expect 'jq' ''
apk_expect 'tree' ''
