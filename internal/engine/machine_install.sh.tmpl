#!/usr/bin/env bash
# The install script of a scaled Norca node, generated by norca-deployer
# (node-scaling install-script) from the plan of cluster {{.Cluster}}, region {{.Region}}.
# Do not edit: generate it again when the plan changes.
#
# Mode {{.Mode}}: {{if eq .Mode "boot"}}the bootstrap of the operator runs it at the first boot,
# before it starts norca-join or the agent.{{else}}run it when the image of the provider is built (Packer or
# by hand); the machines of the image then need no download at boot.{{end}}
# Architecture: {{.Arch}}.
#
# It installs {{if .Packages}}the host packages, {{end}}{{if .Sysctl}}the sysctl tuning, {{end}}the directories, the norca binary,
# {{if .CNI}}the CNI plugins, {{end}}norca-join and the systemd unit of the agent, which it enables but
# does not start: the bootstrap (or norca-join) starts it once the configuration
# and the certificate are there. It does not open the firewall: that is the
# security group of the cloud or the image (the ranges of the region are in the
# Variable nodescaler/network/{{.Region}}).
#
# A second run changes nothing.
set -euo pipefail
umask 022

readonly state_dir={{q .StateDir}}
changed=0
wrote=0

log() { printf '[norca-node-install] %s\n' "$*"; }
warn() { printf '[norca-node-install] WARN: %s\n' "$*" >&2; }
die() {
  printf '[norca-node-install] ERROR: %s\n' "$*" >&2
  exit 1
}

[ "$(id -u)" -eq 0 ] || die "run this script as root"
for tool in sha256sum tar install cmp stat mktemp base64 find; do
  command -v "$tool" >/dev/null 2>&1 || die "$tool is missing"
done

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# fetch URL DEST downloads a file with curl or wget.
fetch() {
  log "downloading $1"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --retry 3 --connect-timeout 30 -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$2" "$1"
  else
    die "curl or wget is needed to download $1"
  fi
}

# sha256_of FILE prints the SHA-256 of a file.
sha256_of() {
  local sum
  sum=$(sha256sum "$1")
  printf '%s\n' "${sum%% *}"
}

# verify FILE SHA256 stops the script unless the file has that digest.
verify() {
  local got
  got=$(sha256_of "$1")
  [ "$got" = "$2" ] || die "$1: sha256 $got does not match the expected $2"
}

# same_mode PATH MODE reports whether a file or directory has the octal mode.
same_mode() {
  [ "$(stat -c %a "$1")" = "$(printf '%o' "$((8#$2))")" ]
}

# put_file PATH MODE writes standard input to PATH unless PATH already has
# that content and mode. wrote is 1 when it changed something.
put_file() {
  local path=$1 mode=$2 tmp
  tmp=$(mktemp "$work/put.XXXXXX")
  cat >"$tmp"
  wrote=0
  if [ -f "$path" ] && cmp -s "$tmp" "$path"; then
    rm -f "$tmp"
    if ! same_mode "$path" "$mode"; then
      chmod "$mode" "$path"
      wrote=1
      changed=1
      log "$path: mode $mode"
    fi
    return 0
  fi
  mkdir -p "$(dirname "$path")"
  install -m "$mode" "$tmp" "$path.norca-new"
  mv -f "$path.norca-new" "$path"
  rm -f "$tmp"
  wrote=1
  changed=1
  log "$path written"
}

# remove_file PATH removes a file that an earlier plan wrote.
remove_file() {
  if [ -e "$1" ]; then
    rm -f "$1"
    changed=1
    log "$1 removed"
  fi
}

# ensure_dir PATH MODE creates a directory, or sets its mode.
ensure_dir() {
  if [ ! -d "$1" ]; then
    mkdir -p "$1"
    chmod "$2" "$1"
    changed=1
    log "$1 created"
  elif ! same_mode "$1" "$2"; then
    chmod "$2" "$1"
    changed=1
    log "$1: mode $2"
  fi
}

# extract_binary ARCHIVE NAME prints the path of the file NAME extracted from
# a .tar.gz release archive.
extract_binary() {
  local dir found
  dir=$(mktemp -d "$work/extract.XXXXXX")
  tar -xzf "$1" -C "$dir"
  found=$(find "$dir" -type f -name "$2" -print -quit)
  [ -n "$found" ] || die "$1 has no $2"
  printf '%s\n' "$found"
}
{{- if .Packages}}

# installed_version NAME prints the version of an installed Debian package.
installed_version() {
  # shellcheck disable=SC2016 # dpkg-query fields, not shell variables
  dpkg-query -W -f='${Status} ${Version}\n' "$1" 2>/dev/null | awk '$3 == "installed" { print $4 }' || true
}

# check_package NAME VERSION sets need_install unless the package is
# installed (at VERSION, when one is given).
check_package() {
  local v
  v=$(installed_version "$1")
  if [ -z "$v" ] || { [ -n "$2" ] && [ "$v" != "$2" ]; }; then
    need_install=1
  fi
}

# require_package NAME VERSION FILE stops the script unless a package that the
# plan installs from a local .deb file is installed: the script cannot reach
# a file on the deployer machine.
require_package() {
  local v
  v=$(installed_version "$1")
  if [ -z "$v" ] || { [ -n "$2" ] && [ "$v" != "$2" ]; }; then
    die "package $1${2:+ $2} is installed from the local file $3 on the deployer machine: install it into the image first"
  fi
}

# expect_package NAME VERSION stops the script unless the package is
# installed (at VERSION, when one is given).
expect_package() {
  local v
  v=$(installed_version "$1")
  [ -n "$v" ] || die "package $1 is not installed after apt-get install"
  if [ -n "$2" ] && [ "$v" != "$2" ]; then
    die "package $1: version $v installed, $2 requested"
  fi
  log "package $1 $v"
}

# is_held NAME reports whether apt holds a package.
is_held() {
  local held
  held=$(apt-mark showhold)
  grep -qxF -- "$1" <<<"$held"
}

# Host packages (host_packages for a client)
log "host packages"
if ! command -v apt-get >/dev/null 2>&1 || ! command -v dpkg-query >/dev/null 2>&1; then
  die "host_packages need a Debian-based machine with apt-get and dpkg"
fi
{{.Packages}}
{{- end}}
{{- if .Sysctl}}

# Host tuning: kernel modules and sysctl (tuning.apply_sysctl)
log "sysctl tuning"
{{file .Sysctl.ModulesPath "0644" .Sysctl.Modules}}
modules_changed=$wrote
if ! { modprobe bridge && modprobe br_netfilter; } >/dev/null 2>&1; then
  warn "the modules bridge and br_netfilter could not be loaded now (they are loaded at boot)"
fi
{{file .Sysctl.SysctlPath "0644" .Sysctl.Sysctl}}
if [ "$wrote" = 1 ] || [ "$modules_changed" = 1 ]; then
  sysctl --system >/dev/null 2>&1 || warn "sysctl --system failed: the settings apply at the next boot"
fi
{{- end}}

# Directories
{{- range .Dirs}}
ensure_dir {{q .Path}} {{.Mode}}
{{- end}}
ensure_dir "$state_dir" 0700

# The norca binary ({{.Version}})
norca_bin={{q .NorcaBinary}}
{{- if eq .Release.Source "host-package"}}
# release.source host-package: the package {{.Release.Package}} provides it; link it into
# the bin directory when it is installed elsewhere (e.g. /usr/bin/norca).
if [ ! -x "$norca_bin" ]; then
  found=$(command -v norca || true)
  if [ -n "$found" ]; then
    ln -sf "$found" "$norca_bin"
    changed=1
    log "$norca_bin linked to $found"
  fi
fi
[ -x "$norca_bin" ] || die "package {{.Release.Package}} did not install an executable norca binary"
{{- else if eq .Release.Source "local-path"}}
# release.source local-path: the binary (or a .tar.gz release archive) is a
# file of the image build, named by NORCA_BINARY.
[ -n "${NORCA_BINARY:-}" ] || die "release.source is local-path: set NORCA_BINARY to the norca binary or release archive (.tar.gz) for linux/{{.Arch}}"
[ -f "$NORCA_BINARY" ] || die "NORCA_BINARY: $NORCA_BINARY is not a file"
{{- if .Release.SHA256}}
verify "$NORCA_BINARY" {{q .Release.SHA256}}
{{- end}}
case "$NORCA_BINARY" in
  *.tar.gz | *.tgz) src=$(extract_binary "$NORCA_BINARY" norca) ;;
  *.zip) die "NORCA_BINARY: a .zip release is for Windows" ;;
  *) src=$NORCA_BINARY ;;
esac
put_file "$norca_bin" 0755 <"$src"
{{- else}}
release_marker="$state_dir/norca-release.sha256"
if [ -f "$release_marker" ] && [ -f "$norca_bin" ] &&
  [ "$(cat "$release_marker")" = "{{.Release.SHA256}} $(sha256_of "$norca_bin")" ]; then
  log "$norca_bin is the binary of the release (unchanged)"
else
  fetch {{q .Release.URL}} "$work/norca.tar.gz"
  verify "$work/norca.tar.gz" {{q .Release.SHA256}}
  src=$(extract_binary "$work/norca.tar.gz" norca)
  put_file "$norca_bin" 0755 <"$src"
  put_file "$release_marker" 0600 < <(printf '%s %s\n' {{q .Release.SHA256}} "$(sha256_of "$norca_bin")")
fi
{{- end}}
{{- if .CNI}}

# The CNI plugins ({{.CNI.Version}})
cni_marker={{q .CNI.Marker}}
{{- if .CNI.Local}}
# cni.source local-path: the archive is a file of the image build, named by
# NORCA_CNI_ARCHIVE.
[ -n "${NORCA_CNI_ARCHIVE:-}" ] || die "cni.source is local-path: set NORCA_CNI_ARCHIVE to the CNI plugin archive (.tgz) for linux/{{.Arch}}"
[ -f "$NORCA_CNI_ARCHIVE" ] || die "NORCA_CNI_ARCHIVE: $NORCA_CNI_ARCHIVE is not a file"
{{- if .CNI.SHA256}}
verify "$NORCA_CNI_ARCHIVE" {{q .CNI.SHA256}}
{{- end}}
cni_sha=$(sha256_of "$NORCA_CNI_ARCHIVE")
if [ -f "$cni_marker" ] && [ "$(cat "$cni_marker")" = "$cni_sha" ]; then
  log "CNI plugins unchanged"
else
  tar -xzf "$NORCA_CNI_ARCHIVE" -C {{q .CNI.Dir}}
  changed=1
  log "CNI plugins installed into {{.CNI.Dir}}"
  put_file "$cni_marker" 0644 < <(printf '%s\n' "$cni_sha")
fi
{{- else}}
if [ -f "$cni_marker" ] && [ "$(cat "$cni_marker")" = {{q .CNI.SHA256}} ]; then
  log "CNI plugins unchanged"
else
  fetch {{q .CNI.URL}} "$work/cni.tgz"
  verify "$work/cni.tgz" {{q .CNI.SHA256}}
  tar -xzf "$work/cni.tgz" -C {{q .CNI.Dir}}
  changed=1
  log "CNI plugins installed into {{.CNI.Dir}}"
  put_file "$cni_marker" 0644 < <(printf '%s\n' {{q .CNI.SHA256}})
fi
{{- end}}
{{- end}}

# norca-join: makes the key of the node on the machine and gets and renews
# its certificate (the operator's join)
join_bin={{q .Join.Path}}
{{- if .Join.URL}}
if [ -f "$join_bin" ] && [ "$(sha256_of "$join_bin")" = {{q .Join.SHA256}} ]; then
  log "$join_bin unchanged"
else
  fetch {{q .Join.URL}} "$work/norca-join"
  verify "$work/norca-join" {{q .Join.SHA256}}
  put_file "$join_bin" 0755 <"$work/norca-join"
fi
{{- else}}
if [ ! -x "$join_bin" ]; then
  warn "norca-join is not at $join_bin: a node that joins with a key of its own needs it." \
    "Put it there (in the image), or set node_scaling.machine.join_download in the plan."
fi
{{- end}}

# The systemd unit of the agent: enabled, not started
{{file .UnitPath "0644" .Unit}}
unit_changed=$wrote
if command -v systemctl >/dev/null 2>&1; then
  if [ -d /run/systemd/system ] && [ "$unit_changed" = 1 ]; then
    systemctl daemon-reload
  fi
  if ! systemctl is-enabled --quiet {{.Service}} 2>/dev/null; then
    systemctl enable --quiet {{.Service}}
    changed=1
    log "{{.Service}} enabled"
  fi
else
  # No systemctl (a container while the image is built): enable the unit the
  # way systemctl does, with the link of its WantedBy target.
  wants=/etc/systemd/system/multi-user.target.wants
  if [ "$(readlink "$wants/{{.Service}}.service" 2>/dev/null || true)" != {{q .UnitPath}} ]; then
    mkdir -p "$wants"
    ln -sfn {{q .UnitPath}} "$wants/{{.Service}}.service"
    changed=1
    log "systemctl not found: {{.Service}} enabled with the link $wants/{{.Service}}.service"
  fi
fi

if [ "$changed" = 1 ]; then
  log "done: the machine is ready for the bootstrap"
else
  log "done: nothing to change"
fi
