#!/bin/sh
# The install script of a scaled Norca node, generated by norca-deployer
# (node-scaling install-script) from the plan of cluster {{.Cluster}}, region {{.Region}}.
# Do not edit: generate it again when the plan changes.
#
# Mode {{.Mode}}: {{if eq .Mode "boot"}}the bootstrap of the operator runs it at the first boot,
# before it starts norca-join or the agent.{{else}}run it when the image of the provider is built (Packer or
# by hand); the machines of the image then need no download at boot.{{end}}
# Architecture: {{.Arch}}. Families: {{.Families}}.
#
# It installs {{if .HasPackages}}the host packages, {{end}}{{if or .Tuning .TuningByFamily}}the sysctl tuning, {{end}}{{if .DNS}}the DNS forwarding of the consul domain, {{end}}the directories, the norca binary,
# {{if .CNI}}the CNI plugins, {{end}}norca-join and the service of the agent (systemd; OpenRC on Alpine), which it
# enables but does not start: the bootstrap (or norca-join) starts it once the
# configuration and the certificate are there.{{if .HasRHEL}} On RHEL it restores the SELinux labels
# of what it changed.{{end}} It does not open the firewall: that is the
# security group of the cloud or the image (the ranges of the region are in the
# Variable nodescaler/network/{{.Region}}).
#
# The steps are those the deployer runs over SSH on the nodes of its
# inventory. It is POSIX sh (dash, bash, busybox ash). A second run changes
# nothing.
set -eu
umask 022

changed=0
wrote=0

log() { printf '[norca-node-install] %s\n' "$*"; }
warn() { printf '[norca-node-install] WARN: %s\n' "$*" >&2; }
die() {
  printf '[norca-node-install] ERROR: %s\n' "$*" >&2
  exit 1
}

[ "$(id -u)" -eq 0 ] || die "run this script as root"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# fetch URL DEST downloads a file with curl or wget.
fetch() {
  log "downloading $1"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --retry 3 --connect-timeout 30 -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$2" "$1"
  else
    die "curl or wget is needed to download $1"
  fi
}

# sha256_of FILE prints the SHA-256 of a file.
sha256_of() {
  sha256_line=$(sha256sum "$1")
  printf '%s\n' "${sha256_line%% *}"
}

# verify FILE SHA256 stops the script unless the file has that digest.
verify() {
  verify_got=$(sha256_of "$1")
  [ "$verify_got" = "$2" ] || die "$1: sha256 $verify_got does not match the expected $2"
}

# same_mode PATH MODE reports whether a file or directory has the octal mode
# (MODE with its leading 0, as stat prints it without).
same_mode() {
  [ "$(stat -c %a "$1")" = "${2#0}" ]
}

# put_file PATH MODE [base64] writes standard input (decoded from base64
# with base64) to PATH unless PATH already has that content (the same
# SHA-256: cmp is not on a minimal RHEL) and mode. wrote is 1 when it
# changed something.
put_file() {
  put_tmp=$(mktemp "$work/put.XXXXXX")
  if [ "${3:-}" = base64 ]; then
    base64 -d >"$put_tmp"
  else
    cat >"$put_tmp"
  fi
  wrote=0
  if [ -f "$1" ] && [ "$(sha256_of "$put_tmp")" = "$(sha256_of "$1")" ]; then
    rm -f "$put_tmp"
    if ! same_mode "$1" "$2"; then
      chmod "$2" "$1"
      wrote=1
      changed=1
      log "$1: mode $2"
    fi
    return 0
  fi
  mkdir -p "$(dirname "$1")"
  install -m "$2" "$put_tmp" "$1.norca-new"
  mv -f "$1.norca-new" "$1"
  rm -f "$put_tmp"
  wrote=1
  changed=1
  log "$1 written"
}

# remove_file PATH removes a file that an earlier plan wrote; it is true
# when it did.
remove_file() {
  [ -e "$1" ] || [ -L "$1" ] || return 1
  rm -f "$1"
  changed=1
  log "$1 removed"
}

# ensure_dir PATH MODE creates a directory, or sets its mode.
ensure_dir() {
  if [ ! -d "$1" ]; then
    mkdir -p "$1"
    chmod "$2" "$1"
    changed=1
    log "$1 created"
  elif ! same_mode "$1" "$2"; then
    chmod "$2" "$1"
    changed=1
    log "$1: mode $2"
  fi
}

# extract_binary ARCHIVE NAME prints the path of the file NAME extracted from
# a .tar.gz release archive.
extract_binary() {
  extract_dir=$(mktemp -d "$work/extract.XXXXXX")
  tar -xzf "$1" -C "$extract_dir"
  extract_found=$(find "$extract_dir" -type f -name "$2" | head -n 1)
  [ -n "$extract_found" ] || die "$1 has no $2"
  printf '%s\n' "$extract_found"
}

# step_lines NAME RC OUTPUT reads the result lines of a step: a change marks
# the machine changed, a warning is a warning, and the error lines (each a
# sentence whose subject is the machine) end the script when RC is not 0.
step_lines() {
  step_errors=
  while IFS= read -r step_line; do
    case $step_line in
    changed\ * | removed\ * | restarted\ *)
      changed=1
      log "$1: $step_line"
      ;;
    warn\ *) warn "$1: ${step_line#warn }" ;;
    error\ *) step_errors="${step_errors:+$step_errors; }${step_line#error }" ;;
    unchanged\ * | '') ;;
    *) log "$1: $step_line" ;;
    esac
  done <<STEP_LINES_EOF
$3
STEP_LINES_EOF
  [ "$2" = 0 ] || die "$1: this machine ${step_errors:-could not be configured}"
}

# os_release KEY prints a value of /etc/os-release without its quotes.
os_release() {
  sed -n "s/^$1=//p" "${NORCA_OS_RELEASE:-/etc/os-release}" 2>/dev/null | head -n 1 | tr -d "\"'"
}

# family_of ID ID_LIKE prints the family of an operating system: its ID
# first, then the IDs of ID_LIKE (as the deployer detects it over SSH).
family_of() {
  # shellcheck disable=SC2086 # ID_LIKE is a list of words
  for family_id in $1 $2; do
    case $family_id in
    debian | ubuntu)
      echo debian
      return 0
      ;;
    rhel | rocky | almalinux | centos | fedora)
      echo rhel
      return 0
      ;;
    alpine)
      echo alpine
      return 0
      ;;
    esac
  done
  echo unknown
}
{{- if .Functions}}

# The functions of the steps
{{.Functions}}
{{- end}}

# The family of this machine: the script has the steps of these families.
os_id=$(os_release ID)
os_family=$(family_of "$os_id" "$(os_release ID_LIKE)")
case $os_family in
{{.FamilyPattern}}) log "family $os_family (${os_id})" ;;
*) die "this script has no install for ${os_id:-this system} (family $os_family); it installs on the families: {{.Families}}" ;;
esac
for tool in sha256sum tar install stat mktemp base64 find; do
  command -v "$tool" >/dev/null 2>&1 || die "$tool is missing"
done
{{- if .HasRHEL}}
if [ "$os_family" = rhel ] && command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" = Enforcing ]; then
  warn "SELinux is enforcing: Norca under SELinux enforcing is not verified yet; the script restores the SELinux labels of what it changes, but the agent and its drivers may be denied (set SELinux to permissive if the agent fails)"
fi
{{- end}}
{{- range .Parts}}
{{- if .Packages}}

# Host packages of the {{.Name}} family (host_packages.{{.Manager}} for a client)
packages_{{.Name}}() {
{{.Packages}}
}
{{- end}}
{{- if .Tuning}}

# Host tuning of the {{.Name}} family: kernel modules and sysctl (tuning.apply_sysctl)
tuning_{{.Name}}() {
{{.Tuning}}
}
{{- end}}
{{- if .Binary}}

# The norca binary ({{$.Version}}) of the {{.Name}} family
binary_{{.Name}}() {
{{.Binary}}
}
{{- end}}

# The service of the agent on the {{.Name}} family: enabled, not started
service_{{.Name}}() {
{{.Service}}
}
{{- end}}
{{- if .HasPackages}}

log "host packages"
case $os_family in
{{- range .Parts}}{{if .Packages}}
{{.Name}}) packages_{{.Name}} ;;
{{- end}}{{end}}
esac
{{- end}}
{{- if .Tuning}}

# Host tuning: kernel modules and sysctl (tuning.apply_sysctl)
log "sysctl tuning"
{{.Tuning}}
{{- end}}
{{- if .TuningByFamily}}

log "sysctl tuning"
case $os_family in
{{- range .Parts}}
{{.Name}}) tuning_{{.Name}} ;;
{{- end}}
esac
{{- end}}
{{- if .DNS}}

# DNS of the host: the consul domain goes to the local Consul agent
# (consul.dns_forwarding). The script is the one the deployer runs on the
# nodes of its inventory; it prints one line per event.
log "consul DNS forwarding"
{{.DNS}}
{{- end}}

{{.Dirs}}
{{if .BinaryByFamily}}
# The norca binary ({{.Version}}) of the family
case $os_family in
{{- range .Parts}}
{{.Name}}) binary_{{.Name}} ;;
{{- end}}
esac
{{- else}}
# The norca binary ({{.Version}})
{{.Binary}}
{{- end}}
{{- if .CNI}}

# The CNI plugins
{{.CNI}}
{{- end}}

# norca-join: makes the key of the node on the machine and gets and renews
# its certificate (the operator's join)
join_bin={{q .Join.Path}}
{{- if .Join.URL}}
if [ -f "$join_bin" ] && [ "$(sha256_of "$join_bin")" = {{q .Join.SHA256}} ]; then
  log "$join_bin unchanged"
else
  fetch {{q .Join.URL}} "$work/norca-join"
  verify "$work/norca-join" {{q .Join.SHA256}}
  put_file "$join_bin" 0755 <"$work/norca-join"
fi
{{- else}}
if [ ! -x "$join_bin" ]; then
  warn "norca-join is not at $join_bin: a node that joins with a key of its own needs it." \
    "Put it there (in the image), or set node_scaling.machine.join_download in the plan."
fi
{{- end}}

case $os_family in
{{- range .Parts}}
{{.Name}}) service_{{.Name}} ;;
{{- end}}
esac

if [ "$changed" = 1 ]; then
  log "done: the machine is ready for the bootstrap"
else
  log "done: nothing to change"
fi
